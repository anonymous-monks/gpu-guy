---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ScrollStory from "../components/ScrollStory.astro";
import ProblemSection from "../components/ProblemSection.astro";
import Services from "../components/Services.astro";
import Manifesto from "../components/Manifesto.astro";
import OpenSource from "../components/OpenSource.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Process from "../components/Process.astro";
