---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
const home = import.meta.env.BASE_URL;
---

<Layout title="Page not found — GPU Guy">
  <Navbar />
  <main class="container error-page" id="main">
    <p class="eyebrow">404 / EXECUTION PATH NOT FOUND</p>
    <h1>
      This is a dead end.
      <br />
      <span class="text-accent">Your GPU problem isn’t.</span>
    </h1>
    <p>The page may have moved. Let’s get you back to the useful part.</p>
    <a class="button" href={home}>
      Back to the site →
    </a>
  </main>
</Layout>
