---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { work } from "../../data/work";
export function getStaticPaths() {
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<Layout
  title={`${entry.title} — Engineering Notes · GPU Guy`}
  description={`${entry.problem} An illustrative investigation outline for GPU performance engineering.`}
>
  <Navbar />
  <main class="container notes-page" id="main">
    <a class="text-link" href={`${home}#work`}>
      ← Back to engineering work
    </a>
    <p class="eyebrow">ENGINEERING NOTEBOOK / {entry.number}</p>
    <h1>{entry.title}</h1>
    <p class="notes-intro">{entry.short}</p>
    <aside class="evidence-notice">
      <strong>Investigation outline · evidence pending</strong>
      <p>
        This is an illustrative technical approach, not a completed case study
        or a claim about a specific client, merged contribution, or measured
        result. Verified links and reproducible measurements can be added when
        available.
      </p>
    </aside>
    <div class="tags">
      {entry.tags.map((t) => (
        <span>{t}</span>
      ))}
    </div>
    {entry.sections.map(([title, body]) => (
      <section class="note-section">
        <h2>{title}</h2>
        <p>{body}</p>
      </section>
    ))}
    <a class="button" href={`${home}#contact`}>
      Discuss a similar problem ↗
    </a>
  </main>
  <Footer />
</Layout>
