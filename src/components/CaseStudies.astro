---
import Icon from "./Icon.astro";
import { work } from "../data/work";

const base = import.meta.env.BASE_URL;
---

<section class="section work-section" id="work">
  <div class="container">
    <div class="heading-row section-heading reveal">
      <div>
        <p class="eyebrow">05 / ENGINEERING NOTEBOOK</p>
        <h2>
          Follow the evidence.
          <br />
          <span class="text-accent">Then change the system.</span>
        </h2>
      </div>
      <p>
        Investigation outlines for GPU and inference problems. Each note
        separates the question, the diagnostic path, and the evidence needed
        before claiming a result.
      </p>
    </div>
    <div class="work-grid">
      {work.map((entry, index) => (
        <article class="work-card reveal">
          <div class="work-diagram">
            <span class="mono">NOTE {entry.number} / SYSTEMS INVESTIGATION</span>
            <div class:list={["diagram-path", { "violet-path": index % 2 === 1 }]} aria-hidden="true">
              <i>PROFILE</i><b>→</b><i>ISOLATE</i><b>→</b><i>VERIFY</i>
            </div>
            <span class="mono">NO PERFORMANCE CLAIM WITHOUT MEASUREMENT</span>
          </div>
          <div class="work-body">
            <span class="pill">INVESTIGATION OUTLINE</span>
            <h3>{entry.title}</h3>
            <p class="work-subtitle">{entry.short}</p>
            <dl>
              <dt>Problem</dt><dd>{entry.problem}</dd>
              <dt>Focus</dt><dd>{entry.focus}</dd>
              <dt>Validation</dt><dd>{entry.validation}</dd>
            </dl>
            <div class="tags">
              {entry.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <a class="text-link" href={`${base}work/${entry.slug}/`}>
              Read the note <Icon name="external" size={18} />
            </a>
          </div>
        </article>
      ))}
    </div>
    <figure style="max-width: 900px; margin: 48px auto 0;">
    <a href={`${base}images/gpt2_rtx5060_benchmark.png`}
    target="_blank" rel="noopener">
    <img 
    src={`${base}images/gpt2_rtx5060_benchmark.png`}
    alt="GPT-2 throughput comparison across four batch sizes, showing about 1.3 times the baseline throughput."
    width="1776"
    height="1064"
    loading="lazy"
    decoding="async"
    style="display" block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 5px;"
    />
    </a>
    <figcaption style="margin-top: 12px; color: var(--muted); font-size: 12px; text-align: center;">
    Visualization using GPT-2 performance on RTX 5060. Click to enlarge.
    </figcaption>
    </figure>
  </div>
</section>
